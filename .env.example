DATABASE_URL="postgresql://marketplace:marketplace_dev@localhost:5432/marketplaceflipper"
AUTH_SECRET="replace-with-a-32-character-or-longer-secret"
APP_URL="http://localhost:3000"

# Optional. Deterministic parsing runs first; AI is used only as a fallback.
OPENAI_API_KEY=""

# Optional. Alerts are logged when unset.
RESEND_API_KEY=""
ALERT_FROM_EMAIL="Lotline <alerts@example.com>"

# Optional. Best Buy Open Box (Buying Options) API key. When unset, the
# bestbuy source falls back to deterministic mock open-box offers.
# Get one at https://developer.bestbuy.com/
BESTBUY_API_KEY=""

# Optional. eBay OAuth token for sold/resale comps (Marketplace Insights API).
# When unset, resale comps use a deterministic mock so the board still works.
EBAY_OAUTH_TOKEN=""
