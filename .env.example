# PostgreSQL
DATABASE_URL="postgresql://pocketmechanic:pocketmechanic_dev@localhost:5432/pocketmechanic"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: maps (leave empty to use ZIP/city distance matching)
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
MAPBOX_TOKEN=""

# Optional: email (Resend). Empty = log-only notification adapter.
RESEND_API_KEY=""
EMAIL_FROM="Pocket Mechanic <hello@example.com>"

# Optional: SMS (Twilio). Empty = log-only SMS adapter.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional: Stripe Connect. Empty = mock PaymentService.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional: Clerk or Supabase Auth (not required for MVP credentials auth)
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
