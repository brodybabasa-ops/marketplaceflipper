  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromOwner User  @relation("TransferFrom", fields: [fromOwnerId], references: [id])
  toOwner   User? @relation("TransferTo", fields: [toOwnerId], references: [id])
}

model AssetShare {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @db.Uuid
  grantorId   String    @db.Uuid
  memberId    String    @db.Uuid
  role        ShareRole @default(VIEW)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  grantor User  @relation("ShareGrantor", fields: [grantorId], references: [id])
  member  User  @relation("ShareRecipient", fields: [memberId], references: [id])

  @@unique([assetId, memberId])
}

model AssetPreferredProvider {
  id                String  @id @default(uuid()) @db.Uuid
  assetId           String  @db.Uuid
  mechanicProfileId String  @db.Uuid
  taxonomyKey       String  @default("")
  createdAt         DateTime @default(now())

  asset    Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)

  @@unique([assetId, mechanicProfileId, taxonomyKey])
}

model MaintenanceItem {
  id              String                @id @default(uuid()) @db.Uuid
  assetId         String                @db.Uuid
  title           String
  taxonomyKey     String
  status          MaintenanceItemStatus @default(UPCOMING)
  source          String                @default("RULE")
  dueUsage        Float?
  dueAt           DateTime?
  remainingUsage  Float?
  notes           String?
  isDemoFixture   Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, status])
}

model TechnicianProfile {
  id                String         @id @default(uuid()) @db.Uuid
  mechanicProfileId String         @db.Uuid
  userId            String?        @unique @db.Uuid
  displayName       String
  title             String?
  active            Boolean        @default(true)
  duty              TechnicianDuty @default(BOTH)
  hoursStart        String         @default("08:00")
  hoursEnd          String         @default("18:00")
  specialties       String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  mechanic     MechanicProfile     @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id])
  jobs         Job[]
  blocks       ScheduleBlock[]
  outcomes     RepairOutcome[]
  skills       TechnicianSkill[]
}

model TechnicianSkill {
  id                  String        @id @default(uuid()) @db.Uuid
  technicianProfileId String        @db.Uuid
  industryKey         String
  taxonomyKey         String?
  manufacturer        String?
  band                ExpertiseBand @default(INSUFFICIENT_DATA)
  verifiedCount       Int           @default(0)
  provenance          DataProvenance @default(COMPUTED)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  technician TechnicianProfile @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)
}

model ProviderLocation {
  id                String   @id @default(uuid()) @db.Uuid
  mechanicProfileId String   @db.Uuid
  name              String
  address           String?
  city              String?
  state             String?
  zip               String?
  latitude          Float?
  longitude         Float?
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mechanic  MechanicProfile    @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  resources ProviderResource[]
  blocks    ScheduleBlock[]
}

model ProviderResource {
  id                String       @id @default(uuid()) @db.Uuid
  mechanicProfileId String       @db.Uuid
  locationId        String?      @db.Uuid
  kind              ResourceKind @default(OTHER)
  name              String
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  mechanic MechanicProfile  @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  location ProviderLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  blocks   ScheduleBlock[]
}

model ScheduleBlock {
  id                  String            @id @default(uuid()) @db.Uuid
  mechanicProfileId   String            @db.Uuid
  jobId               String?           @db.Uuid
  technicianProfileId String?           @db.Uuid
  resourceId          String?           @db.Uuid
  locationId          String?           @db.Uuid
  kind                ScheduleBlockKind @default(WORK)
  title               String
  startsAt            DateTime
  endsAt              DateTime
  status              String            @default("SCHEDULED")
  notes               String?
  overrideReason      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  mechanic   MechanicProfile    @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  job        Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician TechnicianProfile? @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)
  resource   ProviderResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  location   ProviderLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([mechanicProfileId, startsAt])
  @@index([jobId])
}

model WaitlistEntry {
  id                String   @id @default(uuid()) @db.Uuid
  mechanicProfileId String   @db.Uuid
  customerId        String   @db.Uuid
  assetId           String?  @db.Uuid
  jobId             String?  @db.Uuid
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
}

model FleetAccount {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  ownerId     String   @db.Uuid
  city        String?
  state       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation("FleetOwner", fields: [ownerId], references: [id])
  memberships FleetMembership[]
  assignments FleetAssignment[]
  downtime    DowntimeEvent[]
}

model FleetMembership {
  id            String          @id @default(uuid()) @db.Uuid
  fleetId       String          @db.Uuid
  userId        String          @db.Uuid
  role          FleetMemberRole @default(DRIVER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  fleet FleetAccount @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fleetId, userId])
}

model FleetAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  fleetId   String   @db.Uuid
  assetId   String   @db.Uuid
  label     String?
  createdAt DateTime @default(now())

  fleet FleetAccount @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  asset Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([fleetId, assetId])
}

model DowntimeEvent {
  id        String    @id @default(uuid()) @db.Uuid
  fleetId   String?   @db.Uuid
  assetId   String    @db.Uuid
  jobId     String?   @db.Uuid
  reason    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  fleet FleetAccount? @relation(fields: [fleetId], references: [id])
  asset Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model PartsQuote {
  id                String      @id @default(uuid()) @db.Uuid
  jobId             String      @db.Uuid
  mechanicProfileId String      @db.Uuid
  title             String
  source            String
  amountCents       Int
  etaLabel          String?
  selected          Boolean     @default(false)
  provenance        DataProvenance @default(DEMO_FIXTURE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
}

model RoadsideRequest {
  id         String       @id @default(uuid()) @db.Uuid
  customerId String       @db.Uuid
  assetId    String?      @db.Uuid
  kind       RoadsideKind @default(EMERGENCY)
  status     String       @default("OPEN")
  notes      String?
  zip        String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model WalletAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletLedger[]
}

model WalletLedger {
  id        String           @id @default(uuid()) @db.Uuid
  walletId  String           @db.Uuid
  kind      WalletLedgerKind
  amountCents Int
  note      String?
  jobId     String?
  provenance DataProvenance  @default(DEMO_FIXTURE)
  createdAt DateTime         @default(now())

  wallet WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @db.Uuid
  tier      MembershipTier @default(NONE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationContent {
  id                String   @id @default(uuid()) @db.Uuid
  mechanicProfileId String   @db.Uuid
  title             String
  kind              String
  url               String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
}

model HqAlert {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  title       String
  body        String
  href        String?
  severity    String   @default("warning")
  provenance  DataProvenance @default(COMPUTED)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriceBenchmark {
  id           String          @id @default(uuid()) @db.Uuid
  industryKey  String
  taxonomyKey  String
  region       String          @default("UT")
  minCents     Int
  maxCents     Int
  sampleSize   Int
  provenance   DataProvenance  @default(DEMO_FIXTURE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([industryKey, taxonomyKey, region, provenance])
}
