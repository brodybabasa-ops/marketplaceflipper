generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MECHANIC
  ADMIN
  INSPECTOR
  SUPPORT
  FINANCE
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationLevel {
  UNVERIFIED
  PROFILE_VERIFIED
  PROFESSIONAL_VERIFIED
  INSURED
  POCKET_VERIFIED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum ServiceMode {
  MOBILE
  SHOP
  BOTH
}

enum ServiceCategory {
  BRAKES
  ENGINE
  TRANSMISSION
  ELECTRICAL
  SUSPENSION
  STEERING
  COOLING
  AC_HEATING
  STARTING
  CHARGING
  TIRES
  MAINTENANCE
  DIAGNOSTICS
  OTHER
}

enum JobStatus {
  REQUESTED
  ACCEPTED
  SCHEDULED
  EN_ROUTE
  ARRIVED
  CHECKED_IN
  DIAGNOSING
  AWAITING_APPROVAL
  IN_PROGRESS
  QUALITY_CHECK
  READY
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ServiceRequestStatus {
  OPEN
  MATCHED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum EstimateType {
  PRELIMINARY
  PRIMARY
  CHANGE_ORDER
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  SUPERSEDED
}

enum EstimateLineCategory {
  DIAGNOSTIC
  PARTS
  LABOR
  SUPPLIES
  OTHER
}

enum ApprovalAction {
  APPROVED
  DECLINED
}

enum MessageKind {
  TEXT
  PHOTO
  ATTACHMENT
  SYSTEM
}

enum PhotoKind {
  BEFORE
  AFTER
  DIAGNOSIS
  PARTS
  OTHER
}

enum DisputeCategory {
  REPAIR_DIDNT_FIX
  UNEXPECTED_CHARGE
  WORKMANSHIP
  NO_SHOW
  VEHICLE_DAMAGE
  COMMUNICATION
  UNAUTHORIZED_WORK
  WORK_NOT_COMPLETED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum GroupAuthStatus {
  PENDING
  APPROVED
  DECLINED
}

enum FindingStatus {
  GOOD
  MONITOR
  NEEDS_ATTENTION
}

enum VerificationPipelineStatus {
  NOT_STARTED
  APPLICATION_RECEIVED
  REVIEWING
  VISIT_SCHEDULING
  VISIT_SCHEDULED
  EVALUATION_COMPLETED
  VERIFIED
  ADDITIONAL_ACTION
  DENIED
  EXPIRED
  SUSPENDED
  REVOKED
}

enum InspectionKind {
  SHOP
  MOBILE
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum UsageUnit {
  MILES
  KILOMETERS
  ENGINE_HOURS
  OPERATING_HOURS
  CYCLES
  CALENDAR_INTERVAL
  OTHER
}

enum IdentifierKind {
  VIN
  LICENSE_PLATE
  HIN
  ENGINE_SERIAL
  DRIVE_SERIAL
  TRAILER_VIN
  CHASSIS_VIN
  SERIAL_NUMBER
  FLEET_ID
  EQUIPMENT_NUMBER
  EQUIPMENT_ID
  MODEL_NUMBER
  OTHER
}

enum RequestKind {
  REPAIR
  MAINTENANCE
  DIAGNOSTIC
  PRE_PURCHASE
  INSPECTION
  FLEET_PM
  ROADSIDE
}

enum PaymentKind {
  DEPOSIT
  PROGRESS
  FINAL
  REFUND
  PARTIAL_REFUND
}

enum FinancingPartnerStatus {
  NOT_OFFERED
  REFERRED
  PENDING
  APPROVED
  DECLINED
}

enum RepairOutcomeKind {
  YES
  PARTIALLY
  NO
}

enum UrgencyMode {
  NORMAL
  URGENT
}

enum OperatingModel {
  SHOP_ONLY
  MOBILE_ONLY
  HYBRID
  FIELD_SERVICE
  MULTI_LOCATION
  FLEET_SERVICE
}

enum TechnicianDuty {
  SHOP
  OFF_SITE
  BOTH
}

enum ScheduleBlockKind {
  WORK
  DROP_OFF
  PICKUP
  TRAVEL
  BUFFER
  QC
  ROAD_TEST
  WATER_TEST
  BREAK
  PTO
  UNAVAILABLE
  ADMIN
}

enum PartsStatus {
  UNKNOWN
  READY
  ORDERED
  ARRIVING
  DELAYED
}

enum DocumentKind {
  TITLE
  REGISTRATION
  RECEIPT
  WARRANTY
  MANUAL
  INSPECTION
  PURCHASE
  PHOTO
  OTHER
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ShareRole {
  VIEW
  MANAGE
  PAY
  ADMIN
}

enum FleetMemberRole {
  OWNER
  MANAGER
  DISPATCHER
  DRIVER
  OPERATOR
}

enum ResourceKind {
  BAY
  LIFT
  ALIGNMENT_RACK
  DIAGNOSTIC_STATION
  BENCH
  MOTORCYCLE_LIFT
  YARD
  WATER_TEST
  LAUNCH
  SERVICE_TRUCK
  FIELD_UNIT
  DYNO
  WASH
  OTHER
}

enum MaintenanceItemStatus {
  UPCOMING
  DUE_SOON
  DUE
  OVERDUE
  COMPLETED
  DEFERRED
}

enum WalletLedgerKind {
  PAYMENT
  CREDIT
  REFUND
  MAINTENANCE_FUND
  FEE
}

enum RoadsideKind {
  TOW
  JUMP
  TIRE
  LOCKOUT
  FUEL
  MOBILE_DIAGNOSIS
  EMERGENCY
}

enum MembershipTier {
  NONE
  STANDARD
  PLUS
}

enum ExpertiseBand {
  EXCEPTIONAL
  ADVANCED
  COMPETENT
  LIMITED_HISTORY
  INSUFFICIENT_DATA
}

enum DataProvenance {
  VERIFIED_TRANSACTION
  COMPUTED
  DEMO_FIXTURE
  INTEGRATION
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  passwordHash   String
  role           UserRole
  status         AccountStatus @default(ACTIVE)
  firstName      String
  lastName       String
  phone              String?
  avatarUrl          String?
  emailNotifications Boolean       @default(true)
  smsNotifications   Boolean       @default(false)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customerProfile CustomerProfile?
  mechanicProfile MechanicProfile?

  vehicles           Vehicle[]
  assets             Asset[]
  serviceRequests    ServiceRequest[] @relation("CustomerRequests")
  jobsAsCustomer     Job[]            @relation("CustomerJobs")
  jobsAsMechanic     Job[]            @relation("MechanicJobs")
  estimatesCreated   Estimate[]       @relation("MechanicEstimates")
  estimateApprovals  EstimateApproval[]
  threadsAsCustomer  MessageThread[]  @relation("CustomerThreads")
  threadsAsMechanic  MessageThread[]  @relation("MechanicThreads")
  messages           Message[]
  reviewsAuthored    Review[]         @relation("CustomerReviews")
  reviewResponses    ReviewResponse[]
  notifications      Notification[]
  disputesOpened     Dispute[]        @relation("CustomerDisputes")
  disputesAgainst    Dispute[]        @relation("MechanicDisputes")
  adminActions       AdminAction[]
  savedMechanics     SavedMechanic[]
  verificationsReviewed Verification[] @relation("VerificationReviewer")
  fraudSignals       FraudSignal[]
  payouts            Payout[]
  payments           Payment[]
  subscriptions      Subscription[]
  auditEvents        AuditEvent[]
  inspectionsAsInspector VerificationInspection[] @relation("InspectorVisits")
  customerRecommendedWork RecommendedWork[] @relation("CustomerRecommendedWork")
  authorizations     RepairAuthorization[]
  supportTickets     SupportTicket[] @relation("TicketRequester")
  assignedTickets    SupportTicket[] @relation("TicketAssignee")
  technicianProfile  TechnicianProfile?
  fleetMemberships   FleetMembership[]
  ownedFleets        FleetAccount[]          @relation("FleetOwner")
  assetSharesGiven   AssetShare[]            @relation("ShareGrantor")
  assetSharesReceived AssetShare[]           @relation("ShareRecipient")
  wallet             WalletAccount?
  membership         Membership?
  roadsideRequests   RoadsideRequest[]
  repairOutcomes     RepairOutcome[]
  assetTransfersFrom AssetTransfer[]         @relation("TransferFrom")
  assetTransfersTo   AssetTransfer[]         @relation("TransferTo")

  @@index([role, status])
  @@index([email])
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  city      String?
  state     String?
  zip       String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MechanicProfile {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @unique @db.Uuid
  slug                 String            @unique
  businessName         String
  tagline              String?
  bio                  String
  yearsExperience      Int               @default(0)
  serviceMode          ServiceMode       @default(MOBILE)
  shopAddress          String?
  shopCity             String?
  shopState            String?
  shopZip              String?
  latitude             Float
  longitude            Float
  serviceRadiusMiles   Int               @default(25)
  diagnosticPriceCents Int               @default(9500)
  laborRateCents       Int               @default(11000)
  mobileFeeCents       Int               @default(2500)
  startingPriceCents   Int               @default(9500)
  timezone             String            @default("America/Denver")
  profilePhotoUrl      String?
  coverPhotoUrl        String?
  onboardingStep       Int               @default(1)
  profileCompletePct   Int               @default(0)
  verificationLevel    VerificationLevel @default(UNVERIFIED)
  isSponsored              Boolean @default(false)
  acceptsNewJobs           Boolean @default(true)
  stripeConnectAccountId   String?
  stripeChargesEnabled     Boolean @default(false)
  lastVerifiedAt           DateTime?
  isSelect                 Boolean @default(false)
  isFoundingProvider       Boolean @default(false)
  foundingNumber           Int?
  foundingApprovedAt       DateTime?
  subscriptionFeeWaived    Boolean @default(false)
  foundingProgramVersion   String?
  marketplaceEligible      Boolean @default(true)
  verificationPipeline     VerificationPipelineStatus @default(NOT_STARTED)
  operatingModel           OperatingModel?

  averageRating       Float @default(0)
  reviewCount         Int   @default(0)
  completedJobsCount  Int   @default(0)
  onTimePercentage    Float @default(100)
  estimateAccuracy    Float @default(100)
  customerRepeatRate  Float @default(0)
  reviewQualityScore  Float @default(0)
  avgResponseMinutes  Int   @default(30)
  cancellationRate    Float @default(0)
  mechanicScore       Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties    MechanicSpecialty[]
  certifications MechanicCertification[]
  serviceAreas   MechanicServiceArea[]
  availability   MechanicAvailability[]
  blockedDates   MechanicBlockedDate[]
  makeExpertise  MechanicMakeExpertise[]
  verifications  Verification[]
  jobs           Job[]
  reviews        Review[]
  savedBy        SavedMechanic[]
  recommendedWork RecommendedWork[]
  verificationApplications VerificationApplication[]
  verificationInspections VerificationInspection[]
  industries         ProviderIndustry[]
  offerings          ProviderOffering[]
  technicianProfiles TechnicianProfile[]
  locations          ProviderLocation[]
  resources          ProviderResource[]
  scheduleBlocks     ScheduleBlock[]
  waitlist           WaitlistEntry[]
  verificationContent VerificationContent[]
  preferredBy        AssetPreferredProvider[]
  partsQuotes        PartsQuote[]

  @@index([mechanicScore])
  @@index([shopState, shopCity])
  @@index([verificationLevel])
  @@index([serviceMode])
}

model VehicleMake {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models     VehicleModel[]
  vehicles   Vehicle[]
  expertise  MechanicMakeExpertise[]
}

model VehicleModel {
  id        String   @id @default(uuid()) @db.Uuid
  makeId    String   @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  make     VehicleMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([makeId, slug])
  @@index([makeId])
}

model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  year        Int
  makeId      String   @db.Uuid
  modelId     String   @db.Uuid
  trim        String?
  engine      String?
  drivetrain  String?
  mileage     Int
  vin         String?
  plate       String?
  color       String?
  nickname    String?
  notes       String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer        User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make            VehicleMake      @relation(fields: [makeId], references: [id])
  model           VehicleModel     @relation(fields: [modelId], references: [id])
  serviceRequests ServiceRequest[]
  jobs            Job[]
  repairRecords   RepairRecord[]
  inspections     VehicleInspection[]
  recommendedWork RecommendedWork[]
  asset           Asset?

  @@index([customerId])
}

model MechanicSpecialty {
  id                String          @id @default(uuid()) @db.Uuid
  mechanicProfileId String          @db.Uuid
  category          ServiceCategory
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)

  @@unique([mechanicProfileId, category])
}

model MechanicMakeExpertise {
  id                String   @id @default(uuid()) @db.Uuid
  mechanicProfileId String   @db.Uuid
  vehicleMakeId     String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
  make     VehicleMake     @relation(fields: [vehicleMakeId], references: [id], onDelete: Cascade)

  @@unique([mechanicProfileId, vehicleMakeId])
}

model MechanicCertification {
  id                String    @id @default(uuid()) @db.Uuid
  mechanicProfileId String    @db.Uuid
  name              String
  issuer            String
  credentialNumber  String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  documentUrl       String?
  verified          Boolean   @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)
}

model MechanicServiceArea {
  id                String   @id @default(uuid()) @db.Uuid
  mechanicProfileId String   @db.Uuid
  city              String
  state             String
  stateCode         String
  zip               String?
  latitude          Float
  longitude         Float
  radiusMiles       Int      @default(25)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)

  @@index([stateCode, city])
}

model MechanicAvailability {
  id                String    @id @default(uuid()) @db.Uuid
  mechanicProfileId String    @db.Uuid
  dayOfWeek         DayOfWeek
  startTime         String
  endTime           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)

  @@unique([mechanicProfileId, dayOfWeek])
}

model MechanicBlockedDate {
  id                String   @id @default(uuid()) @db.Uuid
  mechanicProfileId String   @db.Uuid
  date              DateTime @db.Date
  reason            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mechanic MechanicProfile @relation(fields: [mechanicProfileId], references: [id], onDelete: Cascade)

  @@unique([mechanicProfileId, date])
}

model ZipCode {
  id        String   @id @default(uuid()) @db.Uuid
  zip       String   @unique
  city      String
  state     String
  stateCode String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stateCode, city])
}

model ServiceRequest {
  id                   String               @id @default(uuid()) @db.Uuid
  customerId           String               @db.Uuid
  vehicleId            String?              @db.Uuid
  assetId              String?              @db.Uuid
  industryId           String?              @db.Uuid
  requestKind          RequestKind          @default(REPAIR)
  taxonomyKey          String?
  mechanicProfileId    String?              @db.Uuid
  status               ServiceRequestStatus @default(OPEN)
  problemText          String
  category             ServiceCategory      @default(OTHER)
  description          String?
  zip                  String
  city                 String?
  state                String?
  latitude             Float?
  longitude            Float?
  preferredDate        DateTime?            @db.Date
  preferredTimeWindow  String?
  budgetCents          Int?
  mobilePreferred      Boolean              @default(true)
  photoUrls            String[]             @default([])
  videoUrls            String[]             @default([])
  whenItHappens        String?
  noticedWhen          String[]             @default([])
  startedWhen          String?
  warningLights        String?
  drivability          String?
  summary              String?
  urgencyMode          UrgencyMode          @default(NORMAL)
  symptoms             String[]             @default([])
  operatingConditions  String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  customer User             @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?         @relation(fields: [vehicleId], references: [id])
  asset    Asset?           @relation(fields: [assetId], references: [id])
  industry Industry?        @relation(fields: [industryId], references: [id])
  jobs     Job[]
  thread   MessageThread?

  @@index([customerId, status])
  @@index([mechanicProfileId, status])
}

model Job {
  id                String        @id @default(uuid()) @db.Uuid
  serviceRequestId  String        @db.Uuid
  customerId        String        @db.Uuid
  mechanicUserId    String        @db.Uuid
  mechanicProfileId String        @db.Uuid
  vehicleId         String?       @db.Uuid
  assetId           String?       @db.Uuid
  status            JobStatus     @default(REQUESTED)
  scheduledAt       DateTime?
  arrivedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  paymentStatus          PaymentStatus @default(UNPAID)
  paymentIntentId        String?
  commissionPercent      Float?
  totalCents             Int           @default(0)
  scheduledConfirmedAt   DateTime?
  urgencyMode            UrgencyMode   @default(NORMAL)
  partsStatus            PartsStatus   @default(UNKNOWN)
  promisedReadyAt        DateTime?
  customerWaiting        Boolean       @default(false)
  technicianProfileId    String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  serviceRequest  ServiceRequest   @relation(fields: [serviceRequestId], references: [id])
  customer        User             @relation("CustomerJobs", fields: [customerId], references: [id])
  mechanicUser    User             @relation("MechanicJobs", fields: [mechanicUserId], references: [id])
  mechanicProfile MechanicProfile  @relation(fields: [mechanicProfileId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  asset           Asset?           @relation(fields: [assetId], references: [id])
  estimates       Estimate[]
  events          JobEvent[]
  photos          JobPhoto[]
  repairRecord    RepairRecord?
  review          Review?
  thread          MessageThread?
  disputes        Dispute[]
  payouts         Payout[]
  payments        Payment[]
  repairGroups    RepairGroup[]
  authorizations  RepairAuthorization[]
  inspections     VehicleInspection[]
  recommendedWork RecommendedWork[]
  outcome         RepairOutcome?
  warranties      RepairWarranty[]
  scheduleBlocks  ScheduleBlock[]
  partsQuotes     PartsQuote[]
  technicianProfile TechnicianProfile? @relation(fields: [technicianProfileId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([mechanicProfileId, status])
  @@index([status])
}

model JobEvent {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid
  status    JobStatus
  note      String?
  createdAt DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Estimate {
  id            String         @id @default(uuid()) @db.Uuid
  jobId         String         @db.Uuid
  mechanicId    String         @db.Uuid
  type          EstimateType   @default(PRIMARY)
  status        EstimateStatus @default(DRAFT)
  parentId      String?        @db.Uuid
  reason        String?
  subtotalCents Int            @default(0)
  totalCents    Int            @default(0)
  notes         String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  job       Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mechanic  User               @relation("MechanicEstimates", fields: [mechanicId], references: [id])
  parent    Estimate?          @relation("EstimateRevisions", fields: [parentId], references: [id])
  children  Estimate[]         @relation("EstimateRevisions")
  lineItems EstimateLineItem[]
  approvals EstimateApproval[]
  repairGroups RepairGroup[]
  authorizations RepairAuthorization[]

  @@index([jobId, status])
}

model EstimateLineItem {
  id          String               @id @default(uuid()) @db.Uuid
  estimateId  String               @db.Uuid
  category    EstimateLineCategory
  description String
  quantity    Float                @default(1)
  unitCents   Int
  totalCents  Int
  repairGroupId String?            @db.Uuid
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  repairGroup RepairGroup? @relation(fields: [repairGroupId], references: [id], onDelete: SetNull)
}

model EstimateApproval {
  id          String         @id @default(uuid()) @db.Uuid
  estimateId  String         @db.Uuid
  userId      String         @db.Uuid
  action      ApprovalAction
  ipAddress   String?
  userAgent   String?
  note        String?
  createdAt   DateTime       @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([estimateId])
}

model MessageThread {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  mechanicId     String   @db.Uuid
  jobId          String?  @unique @db.Uuid
  requestId      String?  @unique @db.Uuid
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer User            @relation("CustomerThreads", fields: [customerId], references: [id])
  mechanic User            @relation("MechanicThreads", fields: [mechanicId], references: [id])
  job      Job?            @relation(fields: [jobId], references: [id])
  request  ServiceRequest? @relation(fields: [requestId], references: [id])
  messages Message[]

  @@index([customerId, lastMessageAt])
  @@index([mechanicId, lastMessageAt])
}

model Message {
  id         String      @id @default(uuid()) @db.Uuid
  threadId   String      @db.Uuid
  senderId   String      @db.Uuid
  kind       MessageKind @default(TEXT)
  body       String
  attachmentUrl String?
  readAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
}

model JobPhoto {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @db.Uuid
  kind      PhotoKind @default(OTHER)
  url       String
